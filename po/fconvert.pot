#: main.cpp:81
msgid ""
"Usage: fconvert [OPTIONS]\n"
"\n"
msgstr ""

#: main.cpp:82
msgid "Options:\n"
msgstr ""

#: main.cpp:83
msgid "  -h, --help        Show this help message\n"
msgstr ""

#: main.cpp:84
msgid "  -l, --list        Show the list of supported formats\n"
msgstr ""

#: main.cpp:85
msgid "  -d, --debug       Enable debug mode (extra logging)\n"
msgstr ""

#: main.cpp:86
msgid "  -cc,              Clear the saved cache and log files\n"
msgstr ""

#: main.cpp:87
msgid "  --clear-cache     of fconvert\n"
msgstr ""

#: main.cpp:88
msgid ""
"  -f, --file <file-name> -<ext>  Quick Convert: convert <file-name> to "
"target extension <ext>\n"
"\n"
msgstr ""

#: main.cpp:89
msgid ""
"  Note: fconvert accepts absolute or relative paths. If no path is provided, "
"it looks in the sandbox directory.\n"
"\n"
msgstr ""

#: main.cpp:90
msgid "Example: \n"
msgstr ""

#: main.cpp:91
msgid ""
"  fconvert -f /path/to/file.jpg -png\n"
"\n"
msgstr ""

#: main.cpp:92
msgid "Interactive Mode:\n"
msgstr ""

#: main.cpp:93
msgid ""
"  Run fconvert without flags to enter the guided menu.\n"
"\n"
msgstr ""

